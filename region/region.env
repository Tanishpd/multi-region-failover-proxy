# Environment shared by all three region services.
#
# This lives in a committed file rather than a YAML anchor because anchors
# SHALLOW-merge: a per-service `environment:` block would replace the anchor's
# entire map, silently dropping everything here. Compose merges env_file and
# environment per-key, so per-service overrides compose correctly.
#
# It is also committed rather than gitignored: a service `env_file:` pointing at
# an untracked file is a hard error on a fresh checkout.

MRFP_MODEL_NAME=mock-echo-1
MRFP_ADMIN_TOKEN=dev-chaos
MRFP_MAX_PROMPT_CHARS=8192
