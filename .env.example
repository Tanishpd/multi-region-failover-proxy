# Copy to .env (make doctor does this for you). .env is gitignored.
# Every application variable is MRFP_-prefixed; nested settings use __.
# Full reference: docs/CONTRACT.md §2

# --- Compose ----------------------------------------------------------------
# The project directory contains spaces and an "&", so the derived project name
# would be mangled. docker-compose.yml also sets `name: mrfp`; this is a belt-
# and-braces fallback for bare `docker compose` invocations. (ADR-002)
COMPOSE_PROJECT_NAME=mrfp

# --- Proxy ------------------------------------------------------------------
# literal = circuit breaker OFF, every request walks the priority list and hits
# the try/except. This is the default and the graded configuration. (ADR-009)
MRFP_MODE=literal

# No default in code: an unset value must raise at boot rather than silently
# connecting to the native redis-server on host port 6379. (ADR-004)
MRFP_REDIS_URL=redis://redis:6379/0

MRFP_REGIONS_FILE=/config/regions.yaml
MRFP_LOG_LEVEL=INFO

# --- Timeouts (milliseconds) ------------------------------------------------
MRFP_READ_TIMEOUT_MS=200
MRFP_CONNECT_TIMEOUT_MS=100
MRFP_POOL_TIMEOUT_MS=50
MRFP_TOTAL_BUDGET_MS=900

# --- Admission / body -------------------------------------------------------
MRFP_MAX_INFLIGHT=128
MRFP_MAX_BODY_BYTES=262144
# An admission slot is held while the body is read, so the read must be bounded
# in time as well as size — otherwise slow uploads wedge the data plane.
MRFP_BODY_READ_TIMEOUT_S=5

# Refuse to boot without Redis. Set 0 only for a deliberately Redis-less run:
# the fallback bucket is per-process, so N replicas would enforce N x the limit.
MRFP_REQUIRE_REDIS=1

# --- Client identity --------------------------------------------------------
# LOOPBACK ONLY, and this is load-bearing. Widening it to RFC1918 makes Docker
# Desktop's bridge gateway — which every external request arrives from — a
# trusted proxy, so any client can name its own rate-limit identity via
# X-Forwarded-For. Measured when compose had 172.16.0.0/12: an honest client
# got 21/60 through a 20/s limit, an XFF-rotating one got 60/60.
# Add the REAL ingress address here, and only that.
MRFP_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Control plane ----------------------------------------------------------
# Guards /admin/* and /debug/*. UNSET MEANS DISABLED (those routes return 404),
# never "open" — DELETE /admin/ratelimit can reset any client's bucket.
MRFP_ADMIN_TOKEN=

# /metrics is separate: scrapers often cannot send a bearer token, and it
# mutates nothing. Set 0 to put it behind MRFP_ADMIN_TOKEN as well.
MRFP_METRICS_PUBLIC=1

# --- Rate limit -------------------------------------------------------------
MRFP_RL_CAPACITY=20
MRFP_RL_REFILL_PER_SEC=20
MRFP_RL_TTL_PAD_MS=2000
MRFP_RL_FAIL_MODE=open

# --- Circuit breaker (resilient mode only) ----------------------------------
MRFP_BREAKER__FAILURE_THRESHOLD=5
MRFP_BREAKER__COOLDOWN_S=5

# --- Chaos ------------------------------------------------------------------
# When 1, an X-Chaos-Bypass header carrying MRFP_CHAOS_TOKEN skips rate
# limiting entirely, so a flood measures failover rather than the rate limiter.
#
# Ships DISARMED, and the token has NO DEFAULT — boot fails if chaos mode is on
# without one. `make chaos` mints a fresh token per run and disarms on exit;
# an earlier version left the proxy armed with a committed literal for the life
# of the container, which is a permanent rate-limit bypass in a public repo.
MRFP_CHAOS_MODE=0
MRFP_CHAOS_TOKEN=

# --- Host-side tooling ------------------------------------------------------
# Used by chaos/ and tests/ running on the host, NOT inside a container.
MRFP_PROXY_URL=http://127.0.0.1:8000
MRFP_REDIS_URL_HOST=redis://127.0.0.1:6380/0
MRFP_REDIS_URL_TEST=redis://127.0.0.1:6380/15
